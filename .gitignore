.DS_Store
__pycache__/
*.pyc

# 측정 결과는 main이 아니라 data 브랜치가 소유한다 — 하루 16개의 봇 커밋이
# main에 섞이면 사람이 한 작업이 히스토리에서 안 보인다. 로컬에서는
# `quickstart.sh`가 data 브랜치에서 받아 이 디렉터리에 풀어 둔다.
data/

# 로컬 실행 상태 — 작업 디렉터리, 큐 DB, 원본 로그
.token-bench/
benchmark/runs/

# 파이썬 가상환경
.venv/

# 개인 에이전트 작업 기록 — 공개 문서 아님
.agent/
.agents/
graphify-out/

# 내부 구현 계획·진행 기록 — 사용자용 문서 아님
archive/

# 개인 도구 설정 — 어떤 플러그인을 켰는지는 기여자마다 다르다.
.claude/settings.json

# 개인 git worktree (자체 .git 포함, 절대 커밋 금지)
.claude/worktrees/

# 에이전트 작업 지침 — 사용자가 볼 필요 없는 md
AGENTS.md
CLAUDE.md
